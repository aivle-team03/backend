# ==============================================================================
# [AIVLE TEAM 03 - Facilities & Safety AI System Environment Configuration]
# 본 파일을 복사하여 .env 이름으로 저장 후 실제 계정 정보 및 키 값을 입력하세요.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (MySQL / Aiven Cloud MySQL)
# ------------------------------------------------------------------------------
DATABASE_URL="mysql+pymysql://root:password@localhost:3306/bigproject"
# ENV="development"  # development 또는 production

# ------------------------------------------------------------------------------
# 2. JWT Security & Authentication
# ------------------------------------------------------------------------------
SECRET_KEY="your-super-secret-jwt-key-here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# 3. Google Cloud Platform & Vertex AI (1st Priority Video/Script Pipeline)
# ------------------------------------------------------------------------------
GCP_PROJECT_ID="your-gcp-project-id"
GOOGLE_APPLICATION_CREDENTIALS="video_create.json"

# ------------------------------------------------------------------------------
# 4. LLM & Image AI Generator Keys (Fallback Pipelines)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your-gemini-api-key"
POLLINATIONS_API_KEY="your-pollinations-api-key"
OPENAI_API_KEY="your-openai-api-key"

# ------------------------------------------------------------------------------
# 5. Cloudinary Media Storage (Video & Image Cloud Host)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
# CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"

# ------------------------------------------------------------------------------
# 6. AWS S3 Storage (Future Transition Ready)
# ------------------------------------------------------------------------------
# EC2에 IAM 역할을 붙이면 아래 두 키 없이도 boto3가 자동으로 자격증명을 가져온다.
# AWS_ACCESS_KEY_ID="your-aws-access-key-id"
# AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
# AWS_REGION="ap-northeast-2"
# AWS_S3_BUCKET_NAME="your-safety-video-bucket-name"

# 게시판·조치이력 이미지 버킷. 미설정이면 로컬 디스크에 저장되며
# 컨테이너 재시작 시 이미지가 전부 사라진다. 운영에서는 반드시 설정할 것.
# AWS_S3_MEDIA_BUCKET="your-media-bucket-name"

# 이미지 응답 URL 접두사. 프론트와 미디어가 같은 CloudFront 뒤에 있으면 비워둔다.
# 로컬 개발에서 S3 버킷을 함께 쓸 때만 CloudFront 주소를 넣는다.
# MEDIA_BASE_URL="https://xxxxxxxx.cloudfront.net"

# ------------------------------------------------------------------------------
# 7. AI 서비스 주소
# ------------------------------------------------------------------------------
# 조치 재확인(/api/ai/verify-action)을 처리하는 AI 서버. 미설정 시 로컬 기본값.
# AI_SERVER_URL="http://127.0.0.1:8001"
# VIDEO_AGENT_URL="http://127.0.0.1:8100"

# ------------------------------------------------------------------------------
# 8. 개발 옵션
# ------------------------------------------------------------------------------
# 실행되는 모든 SQL 을 로그로 출력한다. 운영에서는 켜지 말 것.
# SQL_ECHO="false"
