# 자격증명 — 이미지 레이어에 구워지면 레지스트리 푸시 시 유출된다.
# 런타임에는 compose 의 env_file / 볼륨 마운트로 주입한다.
.env
.env.local
.env.*.local
video_create.json
ca.pem

# 가상환경 — 윈도우용 바이너리라 리눅스 컨테이너에서 쓸 수 없다 (약 520MB)
.venv/
venv/
env/
ENV/

# 생성물·실험 자료 (약 120MB)
static/
scratch/
logs/
*.log

# 파이썬 캐시
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/

# 버전 관리 / 에디터
.git/
.gitignore
.vscode/
.idea/

# 도커 자신
Dockerfile
docker-compose.yml
.dockerignore
